# AI 마음브레이크 코치 v2 — 서버리스 함수 환경변수 (서버에만 설정. 클라이언트에 절대 노출 금지)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 기본값 유지 권장
# COACH_MODEL=claude-opus-5

# 설치 (함수 디렉토리):  npm init -y && npm i @anthropic-ai/sdk
# package.json 에 "type": "module" 추가 (coach.js 는 ESM).
# Netlify: netlify.toml → [functions] directory = "functions"  → 엔드포인트 /.netlify/functions/coach
# Vercel : api/coach.js 에 coach.js 하단의 어댑터 주석을 사용 → 엔드포인트 /api/coach
# 활성화: site/assets/js/coach.js 의 COACH_ENDPOINT 를 위 엔드포인트로 설정
